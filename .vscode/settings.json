{
  "editor.rulers": [100],
  "search.exclude": {
    "dist/**/*": true,
    "node_modules/**/*": true
  },
  "editor.formatOnSave": true,
  "editor.insertSpaces": true,
  "editor.tabSize": 2,
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "files.trimTrailingWhitespace": true,
  "files.encoding": "utf8",
  "i18n-ally.localesPaths": [
    "locales",
    "src/client/context/i18n",
    "src/client/page/maze/maker/messages"
  ],
  "cmtd.showTypeFiles": false,
  "files.exclude": {
    "**/*.module.{d.css,css.d,d.less,less.d,d.sass,sass.d,d.scss,scss.d,d.styl,styl.d,d.stylus,stylus.d}{.ts,.ts.map}": true
  }
}
