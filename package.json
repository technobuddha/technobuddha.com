{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "technobuddha.com",
  "version": "9.1.1-0",
  "description": "Technobuddha application",
  "stableVersion": "9.1.0",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "imports": {
    "#api/*": "./src/api/*/index.js",
    "#context/*": "./src/client/context/*/index.js",
    "#page/*": "./src/client/page/*/index.ts",
    "#client/*": "./src/client/*/index.js",
    "#server/*": "./src/server/*/index.js",
    "#util*": "./src/util*",
    "#settings/*": "./src/settings/*",
    "#config": "./src/config/index.js",
    "#env": "./src/config/env.js"
  },
  "author": {
    "name": "Phil Hill",
    "email": "phil@technobuddha.com",
    "url": "https://technobuddha.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/technobuddha/technobuddha.com"
  },
  "homepage": "https://github.com/technobuddha/technobuddha.com#readme",
  "bugs": {
    "url": "https://github.com/technobuddha/technobuddha.com/issues"
  },
  "scripts": {
    "build": "build default",
    "start": "build dev",
    "import-tracks": "tsx scripts/import-tracks.ts",
    "import-artwork": "tsx scripts/import-artwork.ts",
    "migrate up": "node-pg-migrate --migrations-dir migrations up",
    "migrate down": "node-pg-migrate --migrations-dir migrations down",
    "lint": "npx eslint src",
    "scan": "npx tsx scripts/scanner.ts",
    "publish": "build publish",
    "test": "npx vitest --typecheck run",
    "test:watch": "npx vitest --typecheck --no-coverage watch",
    "test:full": "npx vitest --typecheck --mode=full run",
    "spell": "npx cspell lint src",
    "prepare": "husky"
  },
  "dependencies": {
    "#settings": "latest",
    "@dotenvx/dotenvx": "2.21.0",
    "@google-cloud/translate": "9.3.0",
    "@mui/material": "7.3.10",
    "@technobuddha/color": "0.3.3-12",
    "@technobuddha/controls": "1.0.0-1",
    "@technobuddha/library": "2.1.0-188",
    "@technobuddha/maze": "0.2.0-4",
    "@technobuddha/postgres": "1.0.0-1",
    "@technobuddha/react": "1.0.0-1",
    "ajv": "8.20.0",
    "chalk": "6.0.0",
    "cheferizeIt": "1.0.4",
    "clsx": "2.1.1",
    "comlink": "4.4.2",
    "cookie-parser": "1.4.7",
    "express": "5.2.1",
    "history": "5.3.0",
    "http-proxy-middleware": "3.0.5",
    "i18next": "26.0.5",
    "i18next-browser-languagedetector": "8.2.1",
    "i18next-http-backend": "3.0.4",
    "mustache": "4.2.0",
    "mustache-express": "1.3.2",
    "notistack": "3.0.2",
    "nuqs": "2.8.9",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-i18next": "17.0.4",
    "react-icons": "5.6.0",
    "react-modal-promise": "1.0.2",
